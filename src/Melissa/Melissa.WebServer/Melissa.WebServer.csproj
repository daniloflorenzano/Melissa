<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dab6b485-5e56-45e7-afaa-e775e5b4548f</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="edge-tts-net" Version="1.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.2.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Whisper.net.AllRuntimes" Version="1.8.1" />
        <!-- Explicitly reference the runtime packages and exclude their 'build' assets so
             duplicate ggml-metal.metal files are not provided to MSBuild during publish. -->
        <PackageReference Include="whisper.net.runtime" Version="1.8.1">
          <ExcludeAssets>build</ExcludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="whisper.net.runtime.coreml" Version="1.8.1">
          <ExcludeAssets>build</ExcludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Prevent whisper runtime packages from injecting build assets (they add ggml-metal.metal)
         Excluding `build` assets from these packages stops the duplicated file being added
         into the publish output. NuGet package IDs are case-insensitive. -->
    <ItemGroup>
      <PackageReference Update="whisper.net.runtime" ExcludeAssets="build" />
      <PackageReference Update="whisper.net.runtime.coreml" ExcludeAssets="build" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\\Melissa.Core\\Melissa.Core.csproj" />
    </ItemGroup>

    <!-- Exclude ggml-metal.metal from publish/output to avoid duplicate-file publish errors
         Some whisper.nuget packages include the same file under their build/ folder which
         results in MSBuild reporting duplicate publish output files. The rules below
         attempt to remove any such files from being published. -->
    <ItemGroup>
      <!-- Prevent any Content/None entries matching ggml-metal.metal from being copied -->
      <Content Update="**/ggml-metal.metal">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </Content>
      <None Update="**/ggml-metal.metal">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>
      <!-- As a defensive measure, remove any such items from the item lists so they are
           not treated as publishable files. -->
      <Content Remove="**/ggml-metal.metal" />
      <None Remove="**/ggml-metal.metal" />
    </ItemGroup>

    <!-- Remove ggml-metal.metal from the resolved files to publish BEFORE MSBuild's
         package file conflict resolution runs. Doing this early prevents NETSDK1152
         errors when two runtime packages include the same file. -->
    <Target Name="RemoveDuplicateGgmlMetalFromPublish" BeforeTargets="ResolvePackageFileConflicts">
      <ItemGroup>
        <!-- remove by filename patterns and also guard against case-sensitivity differences -->
        <ResolvedFileToPublish Remove="**/ggml-metal.metal" />
        <ResolvedFileToPublish Remove="**/GGML-*-metal.metal" />
        <ResolvedFileToPublish Remove="**/ggml-metal.*.metal" />
      </ItemGroup>
    </Target>

</Project>
